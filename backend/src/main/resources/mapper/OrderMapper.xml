<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.exportflow.order.infrastructure.OrderMapper">
    <resultMap id="orderResult" type="com.example.exportflow.order.domain.Order">
        <constructor>
            <idArg column="id" javaType="_long"/>
            <arg column="order_no" javaType="java.lang.String"/>
            <arg column="customer_name" javaType="java.lang.String"/>
            <arg column="customer_phone" javaType="java.lang.String"/>
            <arg column="order_status" javaType="com.example.exportflow.order.domain.OrderStatus"/>
            <arg column="payment_status" javaType="com.example.exportflow.order.domain.PaymentStatus"/>
            <arg column="payment_method" javaType="com.example.exportflow.order.domain.PaymentMethod"/>
            <arg column="order_source" javaType="com.example.exportflow.order.domain.OrderSource"/>
            <arg column="item_count" javaType="_int"/>
            <arg column="total_amount" javaType="java.math.BigDecimal"/>
            <arg column="shipping_province" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
            <arg column="paid_at" javaType="java.time.LocalDateTime"/>
            <arg column="updated_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <sql id="columns">
        id, order_no, customer_name, customer_phone, order_status, payment_status, payment_method,
        order_source, item_count, total_amount, shipping_province, created_at, paid_at, updated_at
    </sql>

    <sql id="qualifiedOrderColumns">
        o.id, o.order_no, o.customer_name, o.customer_phone, o.order_status, o.payment_status, o.payment_method,
        o.order_source, o.item_count, o.total_amount, o.shipping_province, o.created_at, o.paid_at, o.updated_at
    </sql>

    <sql id="filters">
        <if test="snapshotMaxId != null">AND id &lt;= #{snapshotMaxId}</if>
        <if test="filter.orderNo != null">AND order_no = #{filter.orderNo}</if>
        <if test="filter.customerName != null">AND customer_name LIKE #{filter.customerNameLike} ESCAPE '\\'</if>
        <if test="filter.customerPhone != null">AND customer_phone = #{filter.customerPhone}</if>
        <if test="filter.orderStatuses != null and !filter.orderStatuses.isEmpty()">
            AND order_status IN
            <foreach collection="filter.orderStatuses" item="value" open="(" separator="," close=")">#{value}</foreach>
        </if>
        <if test="filter.paymentStatuses != null and !filter.paymentStatuses.isEmpty()">
            AND payment_status IN
            <foreach collection="filter.paymentStatuses" item="value" open="(" separator="," close=")">#{value}</foreach>
        </if>
        <if test="filter.paymentMethods != null and !filter.paymentMethods.isEmpty()">
            AND payment_method IN
            <foreach collection="filter.paymentMethods" item="value" open="(" separator="," close=")">#{value}</foreach>
        </if>
        <if test="filter.orderSources != null and !filter.orderSources.isEmpty()">
            AND order_source IN
            <foreach collection="filter.orderSources" item="value" open="(" separator="," close=")">#{value}</foreach>
        </if>
        <if test="filter.minAmount != null">AND total_amount &gt;= #{filter.minAmount}</if>
        <if test="filter.maxAmount != null">AND total_amount &lt;= #{filter.maxAmount}</if>
        <if test="filter.createdFrom != null">AND created_at &gt;= #{filter.createdFrom}</if>
        <if test="filter.createdTo != null">AND created_at &lt;= #{filter.createdTo}</if>
    </sql>

    <select id="findPage" resultMap="orderResult">
        SELECT <include refid="columns"/> FROM orders WHERE 1=1
        <include refid="filters"/>
        ORDER BY created_at DESC, id DESC LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="count" resultType="long" timeout="5">
        SELECT COUNT(*) FROM orders WHERE 1=1 <include refid="filters"/>
    </select>

    <select id="findMaxId" resultType="long">SELECT MAX(id) FROM orders</select>

    <select id="findExistingIds" resultType="long">
        SELECT id FROM orders WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY id
    </select>

    <select id="findExportBatch" resultMap="orderResult" fetchSize="1000">
        SELECT <include refid="columns"/> FROM orders WHERE id &gt; #{afterId}
        <include refid="filters"/>
        ORDER BY id ASC LIMIT #{limit}
    </select>

    <select id="findSelectedBatch" resultMap="orderResult" fetchSize="1000">
        SELECT <include refid="qualifiedOrderColumns"/> FROM orders o
        INNER JOIN export_task_item i ON i.order_id = o.id
        WHERE i.task_id = #{taskId} AND o.id &gt; #{afterId}
        ORDER BY o.id ASC LIMIT #{limit}
    </select>

    <select id="countAll" resultType="long">SELECT COUNT(*) FROM orders</select>

    <insert id="insertBatch">
        INSERT INTO orders (
            order_no, customer_name, customer_phone, order_status, payment_status, payment_method,
            order_source, item_count, total_amount, shipping_province, created_at, paid_at, updated_at
        ) VALUES
        <foreach collection="orders" item="o" separator=",">
            (#{o.orderNo}, #{o.customerName}, #{o.customerPhone}, #{o.orderStatus}, #{o.paymentStatus},
             #{o.paymentMethod}, #{o.orderSource}, #{o.itemCount}, #{o.totalAmount}, #{o.shippingProvince},
             #{o.createdAt}, #{o.paidAt}, #{o.updatedAt})
        </foreach>
    </insert>
</mapper>
